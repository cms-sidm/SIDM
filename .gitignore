*.meta.yaml

# macOS resource forks (created by SSHFS mount on LPC)
._*
.DS_Store

# Per-developer LPC venv (built on the LPC node, not portable)
sidm_venv/

# Condor build/runtime artifacts (regenerated by make_job_args.py / submit / xrdcp)
