condor/smoke_samples.txt
condor/logs/
condor/output/
condor/tmp*cacert.pem
condor/docker_stderror

# Merge workdir created by sidm/scripts/merge_coffea_chunks_eos.py
merge_tmp*/

# Shared-NFS copy of VOMS proxy (each user's, do not commit)
x509_proxy.pem

# Local mirrors of Condor outputs pulled from EOS
signal_chunks/
signal_merged/
background_chunks/
background_merged/

# NFS silly-rename leftovers (visible on the SSHFS mount, harmless)
.nfs*

